# Credentials for the account-specific protocol probe (`cargo run --bin probe`).
#
# Copy this file to `.env` in the same directory and fill in your real Pandora login.
# `.env` is gitignored — never commit it, and never paste its contents into a chat.
#
# These are only read by src/bin/probe.rs, which uses them for exactly one thing: a tuner-API
# `auth.userLogin` against Pandora. They are not stored, logged, or sent anywhere else, and the
# probe prints auth tokens redacted.
#
# The library itself (src/lib.rs and the modules it exposes) never reads the environment — the
# real app will use the OS credential store, not this file.

# The email address you sign in to Pandora with.
PANDORA_USERNAME=you@example.com

# Your Pandora password. If it contains spaces or '#', wrap it in double quotes.
PANDORA_PASSWORD=your-password-here
